# ATLAS MOBILE — configuration locale de développement.
# Copier en .env (non versionné). AUCUN secret ici : tout ce qui commence par
# EXPO_PUBLIC_ est embarqué en clair dans le bundle.

# development | staging | production (fixé par le profil EAS en build cloud)
APP_VARIANT=development

# URL de base du backend ATLAS, sans slash final et sans /api.
# - En développement : backend local joignable depuis le téléphone, ex. http://192.168.1.20:8000
# - Staging / production : HTTPS obligatoire, défini dans l'environnement EAS.
# Le backend filtre par sous-domaine : utiliser un hôte neutre (atlas.*), jamais
# pointage.* / brq.* / recrute.* qui restreignent l'accès à un seul module.
EXPO_PUBLIC_API_URL=

# Fonctions optionnelles activées au build, séparées par des virgules.
# Valeurs : biometrics,gps,nfc,ai,employeeCreation,offline,finance,push,updateCheck,employeePortal,secureScreen
# - biometrics  : verrouillage local par Face ID / empreinte (ajoute le texte Face ID iOS)
# - updateCheck : interroge GET /api/mobile/config
# - secureScreen : bloque captures d'écran et aperçu dans le sélecteur d'applications (FLAG_SECURE sur Android)
# - employeePortal : espace employé en libre-service (jeton employee_mobile, backend à jour requis)
ATLAS_FEATURES=

# Délai d'arrière-plan avant verrouillage biométrique, en secondes (défaut 120).
ATLAS_LOCK_TIMEOUT_SECONDS=

# Liens des fiches store, à renseigner une fois l'application créée sur chaque store.
ATLAS_STORE_URL_IOS=
ATLAS_STORE_URL_ANDROID=

# Renseignés après `eas init` (identifiants de projet, non secrets).
EAS_PROJECT_ID=
EXPO_OWNER=
