{
  "expo": {
    "name": "IRON Recrutement",
    "slug": "iron-recruitment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.irongs.recruitment"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.irongs.recruitment"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisissez une photo pour votre dossier de candidature.",
          "cameraPermission": "Prenez une photo pour votre dossier de candidature.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "scheme": "iron-recruitment"
  }
}
