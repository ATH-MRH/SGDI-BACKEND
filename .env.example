APP_NAME=SGDI FastAPI Backend
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api
ALLOW_PUBLIC_REGISTRATION=false
CORS_ALLOWED_ORIGINS=
STARTUP_MAINTENANCE_ENABLED=false
PUBLIC_EMPLOYEE_PAGES_REQUIRE_TOKEN=true
MAX_PHOTO_UPLOAD_BYTES=5000000

DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_SYSTEM_USERNAME=
ADMIN_SYSTEM_PASSWORD=

# Assistant ATLAS local par défaut. Mettre true uniquement si vous voulez utiliser l'IA payante.
ASSISTANT_PAID_AI_ENABLED=false
# Assistant IA payant optionnel — obtenir sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Alertes email automatiques pour les fins de contrat
CONTRACT_EMAIL_ALERTS_ENABLED=true
CONTRACT_EMAIL_ALERT_WINDOW_DAYS=30
CONTRACT_EMAIL_ALERT_DAYS=
CONTRACT_EMAIL_ALERT_RECIPIENTS=
CONTRACT_EMAIL_ALERT_INTERVAL_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SGDI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONVOCATION_SMTP_HOST=king.o2switch.net
CONVOCATION_SMTP_PORT=465
CONVOCATION_SMTP_USERNAME=adm.conv@irongs.com
CONVOCATION_SMTP_PASSWORD=
CONVOCATION_SMTP_USE_SSL=true

# Départ anticipé minimal pour ABANDON_POSTE (minutes, >= 1)
ATTENDANCE_ABANDON_THRESHOLD_MINUTES=60

# Vérification du téléphone des candidats par SMS (désactivée par défaut).
# Guide complet : docs/recruitment-smsgate.md. Ne jamais committer de valeur réelle ici.
RECRUITMENT_SMS_ENABLED=false
# smsgate = application « SMS Gateway for Android » via son serveur ; poll = ancien protocole maison.
RECRUITMENT_SMS_PROVIDER=smsgate
# URL de l'API du serveur SMSGate privé, chemin compris (https obligatoire).
RECRUITMENT_SMSGATE_API_URL=
# Identifiants affichés par l'application Android après sa connexion au serveur.
RECRUITMENT_SMSGATE_USERNAME=
RECRUITMENT_SMSGATE_PASSWORD=
# Optionnels : téléphone et SIM imposés (1 à 3), clé de signature des webhooks de l'application.
RECRUITMENT_SMSGATE_DEVICE_ID=
RECRUITMENT_SMSGATE_SIM_NUMBER=
RECRUITMENT_SMSGATE_WEBHOOK_SIGNING_KEY=
# Optionnels : priorité (>= 100 : sans délai ni limite côté téléphone), délai d'appel en secondes.
RECRUITMENT_SMSGATE_PRIORITY=100
RECRUITMENT_SMSGATE_TIMEOUT_SECONDS=10
