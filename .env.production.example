# Obligatoire : URL de la base PostgreSQL persistante du serveur.
# Exemple : postgresql+psycopg2://sgdi:mot_de_passe@postgres:5432/sgdi
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_SYSTEM_USERNAME=
ADMIN_SYSTEM_PASSWORD=

# Optional overrides
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
JWT_EXPIRES_MINUTES=720
CORS_ALLOWED_ORIGINS=
STARTUP_MAINTENANCE_ENABLED=false
PUBLIC_EMPLOYEE_PAGES_REQUIRE_TOKEN=true
MAX_PHOTO_UPLOAD_BYTES=5000000

# Performance : nombre de workers Gunicorn. Vide = valeur par défaut de gunicorn.conf.py.
WEB_CONCURRENCY=
# Répertoire persistant des photos/fichiers (monté sur volume dans docker-compose).
SGDI_UPLOADS_DIR=/app/uploads
# Noms d'hôte servant le Portail RH (virgule). Ajouter le sous-domaine de test au besoin.
# Ex. staging : portail-rh.irongs.com,portail-rh-test.irongs.com
PORTAL_HOSTNAMES=portail-rh.irongs.com
# CORS : origines autorisées (virgule). En staging, inclure les sous-domaines de test.
# Ex. : https://test.irongs.com,https://portail-rh-test.irongs.com
CORS_ALLOWED_ORIGINS=

# Cloudflare Tunnel (exposition HTTPS sans ouverture de port). Token du dashboard Zero Trust.
# Requis uniquement si vous lancez le profil : docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Agent IA ATLAS (Phase 1 : lecture seule). Mettre true + fournir la clé pour activer.
# La clé se met dans l'environnement du serveur (Coolify), jamais dans le code/git.
ASSISTANT_AGENT_ENABLED=false
ANTHROPIC_API_KEY=
ASSISTANT_AGENT_MODEL=claude-opus-4-8
# Repli automatique sur un modèle local (Ollama) si Claude echoue / facturation.
ASSISTANT_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b

# Alertes email automatiques pour les fins de contrat
CONTRACT_EMAIL_ALERTS_ENABLED=true
CONTRACT_EMAIL_ALERT_WINDOW_DAYS=30
CONTRACT_EMAIL_ALERT_DAYS=
CONTRACT_EMAIL_ALERT_RECIPIENTS=
CONTRACT_EMAIL_ALERT_INTERVAL_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SGDI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONVOCATION_SMTP_HOST=king.o2switch.net
CONVOCATION_SMTP_PORT=465
CONVOCATION_SMTP_USERNAME=adm.conv@irongs.com
CONVOCATION_SMTP_PASSWORD=
CONVOCATION_SMTP_USE_SSL=true

# ATLAS MOBILE — configuration publique (GET /api/mobile/config). Laisser vide = rien d'imposé.
# Version minimale acceptée par plateforme (format 1.2.3) : en dessous, l'application
# affiche « Mise à jour requise ».
MOBILE_MIN_VERSION_IOS=
MOBILE_MIN_VERSION_ANDROID=
MOBILE_RECOMMENDED_VERSION_IOS=
MOBILE_RECOMMENDED_VERSION_ANDROID=
MOBILE_MAINTENANCE_ENABLED=false
MOBILE_MAINTENANCE_MESSAGE=
MOBILE_STORE_URL_IOS=
MOBILE_STORE_URL_ANDROID=
# Sessions renouvelables ATLAS MOBILE (valeurs par défaut indiquées).
MOBILE_ACCESS_TOKEN_MINUTES=30
MOBILE_REFRESH_TOKEN_DAYS=30
MOBILE_SESSION_MAX_DAYS=90
# Accès mobile employé : durée du jeton en minutes.
EMPLOYEE_MOBILE_TOKEN_MINUTES=480
# Notifications push ATLAS MOBILE. "disabled" : rien n'est envoyé. "expo" : Expo Push Service.
PUSH_PROVIDER=disabled
PUSH_ENVIRONMENT=production
# Secret, à définir dans Coolify uniquement si le projet Expo exige un jeton d'accès.
EXPO_ACCESS_TOKEN=

# Vérification du téléphone des candidats par SMS (désactivée par défaut).
# Guide complet : docs/recruitment-smsgate.md. Ne jamais committer de valeur réelle ici.
RECRUITMENT_SMS_ENABLED=false
# smsgate = application « SMS Gateway for Android » via son serveur ; poll = ancien protocole maison.
RECRUITMENT_SMS_PROVIDER=smsgate
# URL de l'API du serveur SMSGate privé, chemin compris (https obligatoire).
RECRUITMENT_SMSGATE_API_URL=
# Identifiants affichés par l'application Android après sa connexion au serveur.
RECRUITMENT_SMSGATE_USERNAME=
RECRUITMENT_SMSGATE_PASSWORD=
# Optionnels : téléphone et SIM imposés (1 à 3), clé de signature des webhooks de l'application.
RECRUITMENT_SMSGATE_DEVICE_ID=
RECRUITMENT_SMSGATE_SIM_NUMBER=
RECRUITMENT_SMSGATE_WEBHOOK_SIGNING_KEY=
# Optionnels : priorité (>= 100 : sans délai ni limite côté téléphone), délai d'appel en secondes.
RECRUITMENT_SMSGATE_PRIORITY=100
RECRUITMENT_SMSGATE_TIMEOUT_SECONDS=10
