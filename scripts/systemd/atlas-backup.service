# Sauvegarde chiffrée ATLAS — modèle, NON installé par le dépôt. Voir docs/backups.md.
[Unit]
Description=Sauvegarde chiffrée ATLAS (PostgreSQL et fichiers)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=BACKUP_ENV_FILE=/etc/atlas-backup.env
ExecStart=/opt/atlas-backup/scripts/backup.sh
# L'arrêt du service tue tout le groupe : le script efface alors son dossier de travail.
KillMode=control-group
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
UMask=0077
