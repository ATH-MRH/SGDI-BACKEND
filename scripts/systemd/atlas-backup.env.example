# /etc/atlas-backup.env — à créer sur le serveur, propriétaire root, droits 600.
# Aucun secret dans ce fichier quand le chiffrement utilise une clé publique.
# Les valeurs entre <…> sont à remplacer ; ne pas activer la planification avant validation.

BACKUP_DIR=/var/backups/atlas
BACKUP_PG_CONTAINER=<conteneur PostgreSQL>
BACKUP_PG_USER=<rôle PostgreSQL>
BACKUP_PG_DB=<base>
BACKUP_FILES_DIRS='photos=<dossier des photos et documents sur le serveur>'

# Empreinte complète de la clé PUBLIQUE de sauvegarde (la clé privée reste hors du serveur).
BACKUP_GPG_RECIPIENT=<empreinte de 40 caractères>

BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=7

# Copie hors serveur : à renseigner seulement après validation de la destination et de ses accès.
# BACKUP_OFFSITE_RCLONE_DEST=<remote rclone>:<bucket>/atlas
# BACKUP_OFFSITE_REQUIRED=1

# Alerte en cas d'échec et signal de vie après un succès.
# BACKUP_ALERT_COMMAND='<commande qui envoie $ATLAS_BACKUP_MESSAGE>'
# BACKUP_HEARTBEAT_URL=<URL du service de surveillance>
